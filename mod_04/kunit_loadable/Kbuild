# Kbuild — сценарий 2: тесты в отдельном загружаемом модуле
#
# Два независимых .ko файла:
#   strutil_module.ko  — основной модуль (без тестов)
#   strutil_test.ko    — тест-модуль (только при CONFIG_KUNIT != n)

obj-m := strutil_module.o
strutil_module-y := src/strutil_module.o

# Тест-модуль собирается только если KUnit включён
obj-m += strutil_test.o
strutil_test-y := src/strutil_test.o

# Путь к заголовкам внутри src/
ccflags-y := -I$(src)/src
