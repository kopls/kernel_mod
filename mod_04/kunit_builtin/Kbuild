# Kbuild — сценарий 1: тесты встроены в основной .ko
#
# Оба объектных файла компонуются в один модуль kunit_builtin_example.ko
# Файл mymath_test.c компилируется только при CONFIG_KUNIT != n

obj-m := kunit_builtin_example.o
kunit_builtin_example-y := src/mymath_module.o

# Подключаем тест-объект только если KUnit включён
kunit_builtin_example-$(CONFIG_KUNIT) += src/mymath_test.o

# Путь к заголовкам внутри src/
ccflags-y := -I$(src)/src
